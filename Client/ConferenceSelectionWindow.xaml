                            <ComboBoxItem>59</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    <Button x:Name="ScheduleConferenceButton" Style="{StaticResource CustomButton1}" Content="Schedule Conference" Click="ScheduleConference_Click" Height="32"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>