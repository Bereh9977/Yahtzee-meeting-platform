<Window x:Class="Client.ConferenceSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conference Selection" Height="405" Width="400" Background="#FF232323" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Стиль CustomButton1 -->
        <Style x:Key="CustomButton1" TargetType="Button">
            <Setter Property="Background" Value="#FF313131"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF232323"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Стиль для ComboBox -->
        <Style x:Key="CustomComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF212121"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"/>
                                <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                                    <Border Background="#FF313131" BorderBrush="Transparent" BorderThickness="1" MaxHeight="200">
                                        <ScrollViewer>
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Стиль для елементів ComboBox -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FF313131"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF232323"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF232323"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <TabControl Background="#FF313131" BorderBrush="Transparent">
            <!-- Вкладка для створення конференції -->
            <TabItem Header="Create Conference">
                <StackPanel Margin="10">
                    <Button x:Name="CreateConferenceButton" Style="{StaticResource CustomButton1}" Content="Create Conference" Click="CreateConference_Click" Height="31"/>
                </StackPanel>
            </TabItem>
            <!-- Вкладка для приєднання за ID -->
            <TabItem Header="Join by ID">
                <StackPanel Margin="10">
                    <TextBlock Text="Conference ID" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="ConferenceIdTextBox" Margin="0,0,0,10" Background="#FF212121" Foreground="White"/>
                    <Button x:Name="SubmitConferenceIdButton" Style="{StaticResource CustomButton1}" Content="Join" Click="SubmitConferenceId_Click" Height="32"/>
                </StackPanel>
            </TabItem>
            <!-- Вкладка для планування конференції -->
            <TabItem Header="Schedule Conference">
                <StackPanel Margin="10">
                    <TextBlock Text="Select Date:" Foreground="White" Margin="0,0,0,5"/>
                    <Calendar x:Name="ScheduleCalendar" Margin="0,0,0,10"/>

                    <TextBlock Text="Select Time:" Foreground="White" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
