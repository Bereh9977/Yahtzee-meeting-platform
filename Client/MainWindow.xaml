<Window x:Class="Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="1080" Width="1718" Background="#FF232323" Closing="Window_Closing" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="CustomButton0" TargetType="Button">
            <Setter Property="Background" Value="#FF232323"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15" Margin="0,0,-3,-8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF111113"/>
                </Trigger>
            </Style.Triggers>

        </Style>

        <Style x:Key="CustomButton1" TargetType="Button">
            <Setter Property="Background" Value="#FF313131"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15" Margin="0,0,-3,-8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF232323"/>
                </Trigger>
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="#FF232323"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CustomButton2" TargetType="Button">
            <Setter Property="Background" Value="#FFC32A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15" Margin="0,0,-3,-8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF9A0000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="HideCopiedMessageStoryboard">
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CopiedMessage" Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:2" Value="{x:Static Visibility.Collapsed}"/>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Canvas>
        <Rectangle Height="803" Canvas.Left="10" Stroke="Black" Canvas.Top="168" Width="1680" Fill="#FF212121" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Image Name="ShareImage"  Height="803" Width="1680" Canvas.Left="10" Canvas.Top="168" Stretch="Uniform"/>

        <ScrollViewer Height="160" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Left" VerticalAlignment="Center" Width="1718">
            <StackPanel x:Name="stackPanelUsers" Orientation="Horizontal"/>
        </ScrollViewer>

        <Rectangle Height="65" Stroke="Black" Canvas.Top="976" Width="1702" Fill="#FF313131" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        <!--CHANGE Visibility TO HIDE/SHOW CHAT ELEMENTS-->
        <Canvas Name="ChatElemets" Visibility="Collapsed">
            <ComboBox Name="comboboxParticipants" Canvas.Left="996" Canvas.Top="837" Width="120" MaxDropDownHeight="75" Panel.ZIndex="1" Background="Black" SelectionChanged="ShowChatHistory"/>
            <Rectangle Height="65" Stroke="Black" Canvas.Top="976" Width="528" Fill="#FF313131" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1" Canvas.Left="596"/>
            <TextBox x:Name="chatInput" Height="24" Canvas.Left="600" Canvas.Top="1012" Width="320" HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="1"/>
            <Button Style="{StaticResource CustomButton0}" Height="22" Width="50" Canvas.Left="925" Canvas.Top="1008" Click="SendChat_Click" HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="1">
                <Canvas VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="SendOutline"  Width="23" Height="16" VerticalAlignment="Top" Canvas.Left="-9" Canvas.Top="-8" HorizontalAlignment="Left" Foreground="#FF91C313"/>
                </Canvas>
            </Button>
            <Button Style="{StaticResource CustomButton0}" Height="22" Width="50" Canvas.Left="1070" Canvas.Top="1008" Click="SaveChat_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="1">
                <Canvas VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="Download" Width="23" Height="16" VerticalAlignment="Top" Canvas.Left="-9" Canvas.Top="-8" HorizontalAlignment="Left" Foreground="#FF4099D2"/>
                </Canvas>
            </Button>
            <Button Style="{StaticResource CustomButton0}" Height="22" Width="50" Canvas.Left="997" Canvas.Top="1008" Click="UploadFile_Click" Panel.ZIndex="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Canvas VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="Upload" Width="23" Height="16" VerticalAlignment="Top" Canvas.Left="-9" Canvas.Top="-8" HorizontalAlignment="Left" Foreground="#FF4099D2"/>
                </Canvas>
            </Button>
            <ListBox x:Name="chatBox" Height="149" Canvas.Top="830" Width="528" HorizontalAlignment="Center" VerticalAlignment="Top" Canvas.Left="596" Panel.ZIndex="0" BorderBrush="Black" SelectionChanged="ChatBox_SelectionChanged"/>
            <Label Content="Save Chat" Canvas.Left="1056" Canvas.Top="984" Panel.ZIndex="1" Foreground="White" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Label Content="Upload File" Canvas.Left="980" Canvas.Top="984" Panel.ZIndex="1" Foreground="White" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button Style="{StaticResource CustomButton0}" Height="22" Width="50" Canvas.Left="596" Canvas.Top="979" Click="ButtonShowFiles_Click" Panel.ZIndex="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Canvas VerticalAlignment="Center">
                    <fa:ImageAwesome Icon="File" Width="23" Height="16" VerticalAlignment="Top" Canvas.Left="-9" Canvas.Top="-8" HorizontalAlignment="Left" Foreground="#FF4099D2"/>
                </Canvas>
            </Button>
            <Label Content="Show Files" Canvas.Left="651" Canvas.Top="978" Panel.ZIndex="1" Foreground="White" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Canvas>

        <Button Style="{StaticResource CustomButton1}" Name="ButtonChat" Height="51" Width="78" Canvas.Left="430" Canvas.Top="980" Click="ShowChat_Click">
            <Canvas VerticalAlignment="Center">
                <fa:ImageAwesome Icon="CommentsOutline"  Width="33" Height="26" Canvas.Left="-16" Canvas.Top="-20" Foreground="#FF4099D2"/>
                <TextBlock Text="Chat" FontSize="14" Canvas.Left="-15" Canvas.Top="6" FontWeight="Normal"/>
            </Canvas>
        </Button>

        <Button Style="{StaticResource CustomButton1}" Name="ButtonMicrophone" Height="51" Width="80" Canvas.Left="83" Canvas.Top="980" Click="ButtonMicrophone_Click" IsEnabled="True">
            <Canvas VerticalAlignment="Center">
                <fa:ImageAwesome Icon="Microphone"  Width="17" Height="24" Canvas.Left="-9" Canvas.Top="-20" Foreground="White"/>
                <TextBlock Text="Audio" Canvas.Top="6" Canvas.Left="-19" FontSize="14" FontWeight="Normal"/>
            </Canvas>
        </Button>

        <Button Style="{StaticResource CustomButton1}" Name="ButtonCamera" Height="51" Width="79" Canvas.Left="195" Canvas.Top="980" Click="ButtonCamera_Click">
            <Canvas VerticalAlignment="Center">
                <fa:ImageAwesome Icon="VideoCamera"  Width="30" Height="21" Canvas.Left="-15" Canvas.Top="-18" Foreground="White"/>
                <TextBlock Text="Video" Canvas.Top="5" Canvas.Left="-18" FontSize="14" FontWeight="Normal"/>
            </Canvas>
        </Button>

        <Button Style="{StaticResource CustomButton1}" Name="ButtonInvite" Height="51" Width="79" Canvas.Left="314" Canvas.Top="980" Click="GetConferenceID_Click">
            <Canvas VerticalAlignment="Center">
                <fa:ImageAwesome Icon="ShareSquareOutline"  Width="28" Height="26" Canvas.Left="-16" Canvas.Top="-20" RenderTransformOrigin="0.5,0.5" Foreground="#FF4C72AF">
                    <fa:ImageAwesome.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="-1"/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </fa:ImageAwesome.RenderTransform>
                </fa:ImageAwesome>
                <TextBlock Text="Invite" FontSize="14" Canvas.Left="-17" Canvas.Top="6" FontWeight="Normal"/>
            </Canvas>
        </Button>

        <Button Style="{StaticResource CustomButton1}" Name="ButtonShareScreen" Height="51" Width="78" Canvas.Left="1212" Canvas.Top="980" Click="ButtomShareScreen_Click">
            <Canvas VerticalAlignment="Center">
                <fa:ImageAwesome Icon="Desktop"  Width="28" Height="24" Canvas.Left="-14" Canvas.Top="-20" Foreground="#FF02E444"/>
                <TextBlock Text="Share" Canvas.Top="4" Canvas.Left="-18" FontSize="14" FontWeight="Normal"/>
            </Canvas>
        </Button>

        <Button Style="{StaticResource CustomButton1}" Name="ButtonRecord" Height="51" Width="78" Canvas.Left="1334" Canvas.Top="980" Click="ButtonRecord_Click">
            <Canvas VerticalAlignment="Center">
                <fa:ImageAwesome Icon="Circle"  Width="29" Height="23" Canvas.Left="-12" HorizontalAlignment="Left" Foreground="#FFE40606" Canvas.Top="-20"/>
                <TextBlock Text="Record" Canvas.Left="-22" FontSize="14" Canvas.Top="3" FontWeight="Normal"/>
            </Canvas>
        </Button>

        <Button Style="{StaticResource CustomButton2}" Name="ButtonLeave" Height="36" Width="130" Canvas.Left="1555" Canvas.Top="988" Click="ButtonLeave_Click" IsEnabled="True">
            <Canvas VerticalAlignment="Center">
                <fa:ImageAwesome Icon="TimesRectangle"  Width="24" Height="24" VerticalAlignment="Top" Canvas.Left="-42" Canvas.Top="-10" Foreground="Black"/>
                <TextBlock Text="Leave" Canvas.Top="-12" Canvas.Left="-6" FontSize="16"/>
            </Canvas>
        </Button>

        <Border Name="CopiedMessage" Background="#FF00B568" CornerRadius="5" Height="38" Canvas.Top="938" Width="265" Canvas.Left="221" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <fa:ImageAwesome Icon="CheckSquare" Width="16" Height="16" Foreground="White" Margin="5,0,5,0"/>
                <TextBlock Text=" Confrence ID copied to clipboard!" FontSize="14" Foreground="White"/>
            </StackPanel>
        </Border>

    </Canvas>
</Window>